    },
    "node_modules/@infinitas/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@infinitas/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
