      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.8.2"
      }
    },
    "apps/client": {
      "name": "@infinitas/client",
      "version": "0.1.0"
    },
