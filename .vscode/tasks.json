{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Worker Dev",
      "type": "shell",
      "command": "npm",
      "args": [
        "--workspace",
        "@infinitas/worker",
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "\\[wrangler:info\\] Ready on https?://"
        }
      }
    },
    {
      "label": "Tauri Dev",
      "type": "shell",
      "command": "npm",
      "args": [
        "--workspace",
        "@infinitas/client",
        "run",
        "tauri:dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Client Dev Server",
      "type": "shell",
      "command": "npm",
      "args": [
        "--workspace",
        "@infinitas/client",
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "https?://localhost:1420/?"
        }
      }
    },
    {
      "label": "INFINITAS BPL Dev Stack",
      "dependsOn": [
        "Worker Dev",
        "Tauri Dev"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
