{
  "name": "infinitas-bpl",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:client": "npm --workspace @infinitas/client run typecheck",
    "build:client": "npm --workspace @infinitas/client run build"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "wrangler": "^4.70.0"
  }
}
