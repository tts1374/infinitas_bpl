{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "INFINITAS Arena",
  "version": "1.4.0",
  "identifier": "com.infinitas.arena.client",
  "build": {
    "beforeDevCommand": "npm --workspace @infinitas/client run dev",
    "beforeBuildCommand": "npm --workspace @infinitas/client run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "INFINITAS Arena",
        "width": 1280,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "infinitas-arena"
        ]
      }
    },
    "updater": {
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNEFEREU1NjQwMkNBNEYKUldSUHlnSms1ZDFLU2xHSTAxcVZpblRWWHdoWTNzdWlYY0JMRzFSeXNqUjJIYklIcUhjWEppYWgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
